<Page
    x:Class="OpenLinkHub.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OpenLinkHub.App.Views">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}" Spacing="4">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Live temperatures, fan speeds and battery levels. Updates every 3 seconds."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />

            <ItemsRepeater x:Name="Tiles">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="200" MinItemHeight="120" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="views:SensorTile">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{x:Bind Value, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="{x:Bind Source}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
