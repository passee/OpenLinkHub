<Page
    x:Class="OpenLinkHub.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="App theme" Description="Light, dark, or follow Windows">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged" MinWidth="200">
                    <ComboBoxItem Content="Use system setting" Tag="Default" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </toolkit:SettingsCard>

            <TextBlock Text="OpenLinkHub service" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="Service address" x:Name="AddressCard">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Web interface" Description="Every setting, including those not yet in this app"
                                  IsClickEnabled="True" Click="OpenWeb_Click">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </toolkit:SettingsCard.ActionIcon>
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
