<Page
    x:Class="OpenLinkHub.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="4">
            <TextBlock Text="Profiles" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="A profile holds lighting, keys and performance for all devices at once. Games can switch profiles automatically."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="Automatic switching" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="Lock current profile"
                                  Description="Keep the active profile even when a game with its own profile starts">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="LockToggle" Toggled="LockToggle_Toggled" />
            </toolkit:SettingsCard>

            <TextBlock Text="Your profiles" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel x:Name="ProfileList" Spacing="4" />

            <TextBlock Text="Game profiles" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="When one of these games is running, its profile is applied to the listed devices."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <StackPanel x:Name="AppList" Spacing="4" />

            <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Left" Margin="0,12" />
        </StackPanel>
    </ScrollViewer>
</Page>
