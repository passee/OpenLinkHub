<Window
    x:Class="OpenLinkHub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OpenLinkHub">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="140" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/app.ico" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="OpenLinkHub" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />

            <StackPanel x:Name="TitleBarControls" Grid.Column="3" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Border x:Name="ConnectionPill" CornerRadius="12" Padding="10,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionText" Text="Connecting…" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Auto"
            IsBackEnabled="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
            BackRequested="Nav_BackRequested"
            SelectionChanged="Nav_SelectionChanged"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            IsPaneToggleButtonVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Fan curves" Tag="curves">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Macros" Tag="macros">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="DevicesHeader" Content="Devices" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <InfoBar x:Name="Toast" Grid.Row="1" IsOpen="False" IsClosable="True" MaxWidth="560"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24"
                 Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
    </Grid>
</Window>
